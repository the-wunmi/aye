{
  "name": "@aye/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Durable capture-compile workflows (DBOS on Postgres).",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run --testTimeout=30000 --hookTimeout=120000",
    "refinish": "node --env-file-if-exists=../../.env scripts/refinish.ts",
    "rebuild-place": "node --env-file-if-exists=../../.env scripts/rebuild-place.ts"
  },
  "dependencies": {
    "@aye/artifacts": "workspace:*",
    "@aye/db": "workspace:*",
    "@aye/pipeline": "workspace:*",
    "@aye/schema": "workspace:*",
    "@aye/sim": "workspace:*",
    "zod": "catalog:",
    "@dbos-inc/dbos-sdk": "catalog:"
  },
  "devDependencies": {
    "postgres": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "exports": {
    "./jobs": "./src/workflows.ts"
  }
}
