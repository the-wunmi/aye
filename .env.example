# Copy to .env and fill in. Never commit .env. Generate secrets with: openssl rand -hex 24
POSTGRES_USER=aye
POSTGRES_PASSWORD=
POSTGRES_DB=aye
POSTGRES_PORT=5432
# Must match the values above.
DATABASE_URL=postgres://aye:<password>@127.0.0.1:5432/aye

# Where generated content lives, shared by the API and the worker (an absolute path, or a
# volume in production). Unset in development: both default to the repo's .aye/artifacts.
# AYE_ARTIFACT_DIR=/var/lib/aye/artifacts
API_PORT=8787
# Allowed browser origin for the API (CORS). Comma-separated.
WEB_ORIGIN=http://localhost:5173

# Local development only: refused when NODE_ENV=production.
# Set to 1 to let the API accept an `x-aye-dev-user: usr_…` header: anyone who can reach it can
# then act as anyone. Only for scripts on your own machine.
AYE_DEV_AUTH=0

# Meta Model API (Muse). Required by the worker: there is no offline fallback, and it refuses to
# start without it. The API uses it for speech only. Server-side only: never expose it to the browser.
# Create a key at https://dev.meta.ai/ (API keys tab).
MUSE_API_KEY=
# The model id is also the privacy mode:
#   muse-spark-1.3              Standard: Meta does not train on what we send.
#   muse-spark-1.3-contributor  Contributor: cheaper; Meta may train on what we send.
MUSE_TEXT_MODEL=muse-spark-1.3
# minimal | low | medium | high | xhigh
MUSE_EFFORT=medium

# Rebuilding filmed things in 3D (optional). Empty: they keep their library models and pictures.
# fal: SAM 3D Objects as a hosted API. modal: your own GPU endpoint, see reconstruct-providers.ts.
RECONSTRUCT_PROVIDER=
FAL_KEY=
MODAL_RECONSTRUCT_URL=
MODAL_RECONSTRUCT_TOKEN=
MODAL_RECONSTRUCT_VERSION=
